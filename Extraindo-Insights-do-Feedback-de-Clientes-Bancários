```python
import pandas as pd
import numpy as np

np.random.seed(42)
n_records = 600

customer_ids = [f"CLI_{i:04d}" for i in range(1, n_records + 1)]
start_date = pd.to_datetime("2026-05-01")
dates = start_date + pd.to_timedelta(np.random.randint(0, 30, n_records), unit='D')

# Simulate post-update scenario: mostly negative/neutral ratings concentrated in Login, Design, and Transferências
categories = ['Login', 'Transferências', 'Design', 'Atendimento', 'Performance']
category_weights = [0.35, 0.25, 0.20, 0.10, 0.10]
cats = np.random.choice(categories, n_records, p=category_weights)

# Ratings driven by category
ratings = []
comments = []

for cat in cats:
    if cat in ['Login', 'Design']:
        r = np.random.choice([1, 2, 3], p=[0.6, 0.3, 0.1])
    elif cat in ['Transferências']:
        r = np.random.choice([1, 2, 3, 4], p=[0.4, 0.3, 0.2, 0.1])
    else:
        r = np.random.choice([1, 2, 3, 4, 5], p=[0.2, 0.2, 0.3, 0.2, 0.1])
    ratings.append(r)

# Comments based on category and rating
comment_pool = {
    'Login': {
        1: ["Aplicativo fecha sozinho na tela de login.", "Erro 403 constante após a última atualização.", "Não consigo acessar minha conta de jeito nenhum."],
        2: ["Demora muito para carregar a biometria.", "O login cai toda hora."],
        3: ["Consegui entrar depois de limpar o cache."]
    },
    'Design': {
        1: ["O novo visual ficou horrível, muito poluído.", "Letras miúdas, não dá para enxergar nada.", "Onde foram parar meus cartões? Tudo mudou de lugar."],
        2: ["Interface confusa, achei péssimo o novo layout."],
        3: ["Visual moderno, mas difícil de acostumar."]
    },
    'Transferências': {
        1: ["O Pix sumiu da tela inicial!", "Erro ao tentar fazer transferência TED, travou o app."],
        2: ["Pix está demorando para carregar.", "Dificuldade para achar os contatos salvos."],
        3: ["Funciona, mas ficou mais lento."]
    },
    'Atendimento': {
        1: ["Chat não responde, robô fica em looping.", "Ninguém resolve meu problema."],
        2: ["Demora no atendimento humano."],
        3: ["Atendimento razoável."]
    },
    'Performance': {
        1: ["O app esquenta o celular e trava.", "Muito lento depois do update."],
        2: ["Travamentos constantes."],
        3: ["Consome muita bateria agora."]
    }
}

for cat, r in zip(cats, ratings):
    pool = comment_pool.get(cat, {}).get(r, ["Bom app", "Poderia ser melhor", "Ok"])
    comments.append(np.random.choice(pool))

os_list = np.random.choice(['Android', 'iOS'], n_records, p=[0.65, 0.35])

df = pd.DataFrame({
    'ID_Cliente': customer_ids,
    'Data_Feedback': dates,
    'Nota': ratings,
    'Categoria': cats,
    'Comentario': comments,
    'Sistema_Operacional': os_list
})

# Sentiment mapping
def get_sentiment(nota):
    if nota >= 4:
        return 'Positivo'
    elif nota == 3:
        return 'Neutro'
    else:
        return 'Negativo'

df['Sentimento'] = df['Nota'].apply(get_sentiment)

# Analysis: Complaints by category (Negative and Neutral)
complaints = df[df['Sentimento'].isin(['Negativo', 'Neutro'])]
summary_table = complaints.groupby('Categoria').agg(
    Volume_Reclamacoes=('ID_Cliente', 'count'),
    Nota_Media=('Nota', 'mean')
).reset_index()

summary_table['Percentual'] = (summary_table['Volume_Reclamacoes'] / len(complaints)) * 100
summary_table = summary_table.sort_values(by='Volume_Reclamacoes', ascending=False)
print(summary_table.to_string(index=False))
print("\nTotal de registros:", len(df))
print("Distribuição de Sentimento:\n", df['Sentimento'].value_counts())


```

